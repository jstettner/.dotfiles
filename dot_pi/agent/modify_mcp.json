{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve machine-local servers and credentials; only manage Cua Driver. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (hasKey $config "mcpServers") -}}
{{-   $_ := set $config "mcpServers" (dict) -}}
{{- end -}}
{{- $_ := set $config.mcpServers "cua-driver" (dict
      "command" "cua-driver"
      "args" (list "mcp")
      "description" "Observe and operate desktop apps and browsers.") -}}
{{ $config | toPrettyJson }}

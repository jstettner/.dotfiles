{{- /* chezmoi:modify-template */ -}}
{{- /* scripts/capture.sh snapshots Pi's settings.json into .chezmoitemplates. */ -}}
{{- /* Pi rewrites these keys itself (self-update, UI toggles); keep whatever is on disk. */ -}}
{{- /* Pi writes the file without a trailing newline, so drop the snapshot's. */ -}}
{{- $settings := include ".chezmoitemplates/pi-settings.json" | trimSuffix "\n" -}}
{{- if .chezmoi.stdin -}}
{{-   $current := fromJson .chezmoi.stdin -}}
{{-   range $key := .pi.runtimeKeys -}}
{{-     if hasKey $current $key -}}
{{-       $pattern := printf `"%s": (?:"[^"]*"|true|false|null|-?[0-9.]+)` $key -}}
{{-       $value := printf `"%s": %s` $key (toJson (index $current $key)) -}}
{{-       $settings = regexReplaceAllLiteral $pattern $settings $value -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $settings -}}

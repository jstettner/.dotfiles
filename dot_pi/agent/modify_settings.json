{{- /* chezmoi:modify-template */ -}}
{{- /* scripts/capture.sh snapshots Pi's settings.json into .chezmoitemplates. */ -}}
{{- /* Pi bumps lastChangelogVersion on self-update; keep whatever is on disk. */ -}}
{{- $settings := include ".chezmoitemplates/pi-settings.json" -}}
{{- if .chezmoi.stdin -}}
{{-   $current := fromJson .chezmoi.stdin -}}
{{-   if hasKey $current "lastChangelogVersion" -}}
{{-     $version := printf `"lastChangelogVersion": %s` (toJson $current.lastChangelogVersion) -}}
{{-     $settings = regexReplaceAllLiteral `"lastChangelogVersion": "[^"]*"` $settings $version -}}
{{-   end -}}
{{- end -}}
{{- $settings -}}

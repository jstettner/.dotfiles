#!/usr/bin/env python3
"""Manage only the lazy NVM and Starship blocks, preserving machine-local shell settings."""
import re
import sys

BEGIN = "# >>> chezmoi lazy-nvm >>>"
END = "# <<< chezmoi lazy-nvm <<<"
LEGACY_LAZY = '''# Load NVM on the first Node command instead of delaying every new shell.
export NVM_DIR="$HOME/.nvm"
if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
  function nvm node npm npx corepack {
    local nvm_command=${funcstack[1]}
    unfunction nvm node npm npx corepack
    source /opt/homebrew/opt/nvm/nvm.sh || return $?
    [[ ! -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] ||
      source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
    "$nvm_command" "$@"
  }
fi
'''
PREVIOUS_LAZY = '''# Load NVM on the first Node command instead of delaying every new shell.
export NVM_DIR="$HOME/.nvm"
if [[ -s /opt/homebrew/opt/nvm/nvm.sh || -s "$NVM_DIR/nvm.sh" ]]; then
  function nvm node npm npx corepack {
    local nvm_command=${funcstack[1]}
    unfunction nvm node npm npx corepack
    if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
      source /opt/homebrew/opt/nvm/nvm.sh || return $?
      [[ ! -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] ||
        source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
    else
      source "$NVM_DIR/nvm.sh" || return $?
    fi
    "$nvm_command" "$@"
  }
fi
'''
LAZY = '''# Load NVM on the first Node command instead of delaying every new shell.
export NVM_DIR="$HOME/.nvm"
# Until then, put the default version's global CLIs (cf, wrangler, ...) on PATH, after everything else.
() {
  local default=${$(<"$NVM_DIR/alias/default" 2>/dev/null)#v}
  local bins=("$NVM_DIR"/versions/node/v${default}*/bin(N/nOn))
  [[ -z $default ]] || (( ! $#bins )) || path+=("${bins[1]}")
}
if [[ -s /opt/homebrew/opt/nvm/nvm.sh || -s "$NVM_DIR/nvm.sh" ]]; then
  function nvm node npm npx corepack {
    local nvm_command=${funcstack[1]}
    unfunction nvm node npm npx corepack
    if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
      source /opt/homebrew/opt/nvm/nvm.sh || return $?
      [[ ! -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] ||
        source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
    else
      source "$NVM_DIR/nvm.sh" || return $?
    fi
    "$nvm_command" "$@"
  }
fi
'''
LOCAL_EAGER = '''# Remove inherited NVM version paths so nvm.sh can put the selected version first.
path=(${path:#$HOME/.nvm/versions/node/*/bin})
source ~/.nvm/nvm.sh
'''
EAGER = '''# Node version manager
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
'''
STARSHIP_BEGIN = "# >>> chezmoi starship >>>"
STARSHIP_END = "# <<< chezmoi starship <<<"
STARSHIP = '''# Starship prompt; its config is ~/.config/starship.toml.
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
'''
LEGACY_STARSHIP = re.compile(r'(?m)^[ \t]*eval "\$\(starship init zsh\)"[ \t]*\n?')


def replace_block(current, begin, end, body, label):
    block = begin + "\n" + body + end + "\n"
    if begin not in current and end not in current:
        return None
    pattern = re.compile(r"(?m)^" + re.escape(begin) + r"\n[\s\S]*?^" + re.escape(end) + r"(?:\n|$)")
    matches = list(pattern.finditer(current))
    if len(matches) != 1 or current.count(begin) != 1 or current.count(end) != 1:
        raise ValueError(f"Malformed {label} markers; leaving .zshrc unchanged")
    return pattern.sub(lambda _: block, current)


def append_block(current, block):
    separator = "" if not current or current.endswith("\n") else "\n"
    return current + separator + block


def modify_nvm(current):
    block = BEGIN + "\n" + LAZY + END + "\n"
    replaced = replace_block(current, BEGIN, END, LAZY, "lazy-nvm")
    if replaced is not None:
        return replaced
    for previous in (LAZY, PREVIOUS_LAZY, LEGACY_LAZY, EAGER, LOCAL_EAGER):
        if current.count(previous) == 1:
            return current.replace(previous, block, 1)
    if re.search(r"(?m)^[^#\n]*nvm\.sh", current):
        raise ValueError("Unrecognized NVM initialization; migrate it manually before applying")
    return append_block(current, block)


def modify_starship(current):
    block = STARSHIP_BEGIN + "\n" + STARSHIP + STARSHIP_END + "\n"
    replaced = replace_block(current, STARSHIP_BEGIN, STARSHIP_END, STARSHIP, "starship")
    if replaced is not None:
        return replaced
    if len(LEGACY_STARSHIP.findall(current)) == 1:
        return LEGACY_STARSHIP.sub(lambda _: block, current)
    if re.search(r"(?m)^[^#\n]*starship init", current):
        raise ValueError("Unrecognized Starship initialization; migrate it manually before applying")
    return append_block(current, block)


def modify(current):
    return modify_starship(modify_nvm(current))


if __name__ == "__main__":
    try:
        sys.stdout.write(modify(sys.stdin.read()))
    except ValueError as error:
        sys.exit(str(error))

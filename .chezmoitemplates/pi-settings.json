{
  "lastChangelogVersion": "0.87.1",
  "theme": "system",
  "defaultTools": [
    "+codemode"
  ],
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "packages": [
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    },
    "npm:pi-claude-bridge",
    "npm:pi-web-access",
    "~/src/pi-spin",
    "git:github.com/jstettner/pi-subagent",
    "git:github.com/humanlayer/humanlayer-pi"
  ],
  "hideThinkingBlock": false,
  "tuiMode": "fullscreen",

export HERMES_NODE_SKIP_LINKS=1
export PATH="$HOME/.local/bin:$PATH"

# Load NVM on the first Node command instead of delaying every new shell.
export NVM_DIR="$HOME/.nvm"
if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
  function nvm node npm npx corepack {
    local nvm_command=${funcstack[1]}
    unfunction nvm node npm npx corepack
    source /opt/homebrew/opt/nvm/nvm.sh || return $?
    [[ ! -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] ||
      source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
    "$nvm_command" "$@"
  }
fi

# bun completions
[ -s "/Users/stet/.bun/_bun" ] && source "/Users/stet/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
eval "$(starship init zsh)"

setopt SHARE_HISTORY        # share history across sessions in real time
setopt APPEND_HISTORY       # append rather than overwrite
setopt HIST_IGNORE_DUPS     # skip duplicate entries

# Added by cua-driver-rs installer — see https://github.com/trycua/cua

alias zj=zellij
alias ssh="TERM=xterm-256color ssh"

# Keep a Zellij tab named after the current pane's directory.
autoload -Uz add-zsh-hook

_zellij_update_tab_name() {
  [[ -n "$ZELLIJ" ]] || return
  zellij action rename-tab "${PWD:t}"
}

add-zsh-hook chpwd _zellij_update_tab_name
_zellij_update_tab_name

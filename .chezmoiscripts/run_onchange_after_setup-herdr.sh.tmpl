#!/usr/bin/env bash
# chezmoi runs this after apply whenever this script or a hashed input changes.
# A failed run is not recorded, so it retries on the next apply.
# Local plugin manifests:{{ range .herdr.localPlugins }} {{ include (joinPath .source "herdr-plugin.toml") | sha256sum }}{{ end }}
{{ template "path.sh" . }}
set -euo pipefail

# go builds herdr-arrange; python3 runs worktree-labels.
for tool in herdr git go python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Missing prerequisite: %s\n' "$tool" >&2
    exit 1
  fi
done

herdr integration install pi
# Plugins come from .chezmoidata/herdr.json, which scripts/capture.sh writes.
{{- range .herdr.plugins }}
herdr plugin install {{ .repo }} --ref {{ .ref }} --yes
{{- end }}
{{- range .herdr.localPlugins }}
herdr plugin link "$HOME/{{ .path }}"
{{- end }}
# Startup hooks do not run on link; refresh now if a server is already running.
if herdr api snapshot >/dev/null 2>&1; then
  herdr plugin action invoke local.worktree-labels.refresh
fi
herdr config check
printf '\nHerdr plugins installed. Log into Pi with /login and GitHub with gh auth login.\n'
printf 'For a running Herdr server, run: herdr server reload-config\n'

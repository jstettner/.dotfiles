#!/usr/bin/env bash
# chezmoi runs this after apply whenever this script or a hashed input changes.
# A failed run is not recorded, so it retries on the next apply.
# lazy-lock.json: {{ include "dot_config/nvim/lazy-lock.json" | sha256sum }}
{{ template "path.sh" . }}
set -euo pipefail

# cc and tree-sitter build parsers; node and npm let Mason install ts_ls.
for tool in nvim git node npm cc tree-sitter; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Missing prerequisite: %s\n' "$tool" >&2
    exit 1
  fi
done

# First-run install records the bootstrap's lazy.nvim (stable branch) in the
# lockfile, so put the committed lockfile back before restoring from it.
nvim --headless +qa
cp "{{ .chezmoi.sourceDir }}/dot_config/nvim/lazy-lock.json" "$HOME/.config/nvim/lazy-lock.json"
# Restore, rather than update, the committed plugin versions.
nvim --headless '+Lazy! restore' +qa
printf '\nNeovim plugins restored.\n'
